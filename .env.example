# ---------------------------------------------------------------- Supabase
# Project Settings → API. Auth (email + password, Google) runs through Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Server-only. All Clutch data is stored here; without it, data lives in memory.
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------- App
# Public base URL, used in email and OAuth links. Optional locally.
APP_URL=http://localhost:3000

# Signs the demo-account and demo-scope cookies. Required in production: openssl rand -hex 32
AUTH_SECRET=

# One-click demo accounts (Maya, Derek…) with fictional data. Set to "off" for a real launch.
CLUTCH_DEMO_LOGINS=on

# Comma-separated emails that get the Clutch reviewer (admin) role when they sign up.
CLUTCH_ADMIN_EMAILS=

# Local browser testing of the real marketplace: /api/test-login signs in example.test accounts.
# Only outside production, and only with no DATABASE_URL or a database on localhost/127.0.0.1
# (npm run db:local). Leave off otherwise.
# CLUTCH_TEST_LOGINS=on

# "normalized" stores the real marketplace in normalized tables (see README). Off by default.
# Run scripts/migrate-live.ts --apply before switching it on.
# CLUTCH_LIVE_STORE=normalized
# With it on, reads are targeted (docs/live-reads.md). "snapshot" is the explicit rollback to the
# older whole-marketplace cache; leave unset otherwise.
# CLUTCH_LIVE_READS=snapshot

# ---------------------------------------------------------------- Alerts (off; see README)
# Nothing is emailed or texted until a provider adapter exists, these are set, and the switch is on.
# CLUTCH_OUTBOUND_ALERTS=on
# CLUTCH_EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=alerts@your-domain
# Enables POST /api/cron/deliver-alerts for a hosted scheduler (off when unset).
# CLUTCH_CRON_SECRET=

# ---- Verification (docs/verification.md) ----
# Identity: a hosted government-ID + live-selfie + face-match flow. Unset = identity isn't
# available (the app says so; nothing is ever shown as verified without a real check).
# CLUTCH_IDENTITY_PROVIDER=stripe_identity
# STRIPE_IDENTITY_SECRET_KEY=rk_live_...      # restricted key, Identity: write. Server only.
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...    # from the webhook endpoint /api/verification/webhook/stripe_identity
# Signs 5-minute links to verification documents for reviewers (falls back to AUTH_SECRET).
# CLUTCH_SIGNING_SECRET=
# Background check / driving record: stays disabled until a provider AND an approved
# adjudication policy exist. No adapter ships yet.
# CLUTCH_BACKGROUND_PROVIDER=
# CLUTCH_BACKGROUND_POLICY_APPROVED=yes
# Tests only (never in production): the deterministic test identity provider.
# CLUTCH_TEST_PROVIDERS=on
# CLUTCH_TEST_IDENTITY_SECRET=
