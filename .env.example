# ---------------------------------------------------------------- Supabase
# Project Settings → API. Auth (email + password, Google) runs through Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Server-only. All Clutch data is stored here; without it, data lives in memory.
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------- App
# Public base URL, used in email and OAuth links. Optional locally.
APP_URL=http://localhost:3000

# Signs the demo-account cookie. Required in production: openssl rand -hex 32
AUTH_SECRET=

# One-click demo accounts (Maya, Derek…) with fictional data. Set to "off" for a real launch.
CLUTCH_DEMO_LOGINS=on

# "off" starts a new database empty instead of with the fictional demo mechanics and customers.
# Use it (with CLUTCH_DEMO_LOGINS=off) for a real launch. Only applies the first time the database is set up.
CLUTCH_SEED=on

# Comma-separated emails that get the Clutch reviewer (admin) role when they sign up.
CLUTCH_ADMIN_EMAILS=
